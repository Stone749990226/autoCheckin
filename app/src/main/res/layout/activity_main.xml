<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout android:orientation="vertical" android:padding="20dp"
        android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/main_text_1" android:textSize="28sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="@string/main_text_2" />
        <Switch android:id="@+id/enabled" android:layout_width="match_parent"
            android:layout_height="56dp" android:text="@string/main_text_3" />
        <LinearLayout android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_width="match_parent" android:layout_height="wrap_content">
            <Switch android:id="@+id/clock_in_enabled" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="56dp" android:layout_marginEnd="12dp" android:text="@string/clock_in" />
            <Button android:id="@+id/clock_in_time" android:layout_width="120dp"
                android:layout_height="wrap_content" android:text="@string/clock_in_default" />
        </LinearLayout>
        <LinearLayout android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_width="match_parent" android:layout_height="wrap_content">
            <Switch android:id="@+id/clock_out_enabled" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="56dp" android:layout_marginEnd="12dp" android:text="@string/clock_out" />
            <Button android:id="@+id/clock_out_time" android:layout_width="120dp"
                android:layout_height="wrap_content" android:text="@string/clock_out_default" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/schedule_hint" />
        <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingTop="8dp" android:paddingBottom="12dp" android:textIsSelectable="true" />
        <Button android:id="@+id/test_launch" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/main_text_5" />
        <Button android:id="@+id/test_full" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/main_text_6" />
        <Button android:id="@+id/stop_run" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/main_text_7" />
        <Button android:id="@+id/logs" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/main_text_8" />
        <Button android:id="@+id/mail_settings" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/mail_title" />
        <Button android:id="@+id/motion_settings" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/motion_title" />
        <Button android:id="@+id/advanced" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/main_text_9" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="@string/main_text_10" android:textSize="20sp" android:textStyle="bold" />
        <TextView android:id="@+id/permissions" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingTop="8dp" android:paddingBottom="8dp" />
        <Button android:id="@+id/exact" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/main_text_11" />
        <Button android:id="@+id/notification" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/main_text_12" />
        <Button android:id="@+id/battery" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/main_text_13" />
        <Button android:id="@+id/vendor_power" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/main_text_18" />
        <Button android:id="@+id/accessibility" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/main_text_14" />
        <Button android:id="@+id/admin" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/main_text_15" />
        <Button android:id="@+id/app_settings" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/main_text_16" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="@string/main_text_17" />
    </LinearLayout>
</ScrollView>
